            <label class="f"><span>Up. (nama PIC)</span><input class="in" name="client.attn" value="${esc(v.client.attn)}" /></label>
            <label class="f"><span>WhatsApp</span><input class="in" name="client.phone" inputmode="tel" value="${esc(v.client.phone)}" /></label>
            <label class="f"><span>Email</span><input class="in" name="client.email" inputmode="email" value="${esc(v.client.email)}" /></label>
            <label class="f s2"><span>Alamat</span><input class="in" name="client.address" value="${esc(v.client.address)}" /></label>
          </div>
        </section>
        <section class="sheet">
          <div class="sheet-h"><h2>Acara</h2>${kind === 'invoice' && !d ? '<span class="hint">Tanggal acara diisi → otomatis masuk Jadwal.</span>' : ''}</div>
          <div class="sheet-b grid g3">
            <label class="f"><span>Nama acara</span><input class="in" name="event.title" value="${esc(v.event.title)}" placeholder="mis. Gathering Akhir Tahun" /></label>
