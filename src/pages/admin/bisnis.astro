      <label class="f"><span>Qty</span><input class="in num" name="qty" inputmode="decimal" value="${i.qty ?? 1}" /></label>
      <label class="f"><span>Harga satuan</span><input class="in num" name="price" inputmode="numeric" data-rp value="${i.unit_price ? rp(i.unit_price) : ''}" placeholder="0" /></label>
