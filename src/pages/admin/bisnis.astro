            <label class="f"><span>Jam</span><input class="in" name="event.time" value="${esc(v.event.time)}" placeholder="mis. 17.00 – selesai" /></label>
            <label class="f"><span>Tempat</span><input class="in" name="event.venue" value="${esc(v.event.venue)}" /></label>
            <label class="f"><span>Kota</span><input class="in" name="event.city" value="${esc(v.event.city)}" /></label>
          </div>
        </section>
        <section class="sheet">
          <div class="sheet-h"><h2>Layanan</h2></div>
          <div class="items" data-items>${(v.items.length ? v.items : [{}]).map(itemRow).join('')}</div>
          <div class="item-foot">
            <div class="item-add">
              <div class="pw"><button class="b b-ink b-sm" type="button" data-pkg-menu ${pkgs.length ? '' : 'disabled title="Belum ada paket aktif — isi di Paket & harga"'}>${ic('plus')}Dari paket</button></div>
              <button class="b b-ghost b-sm" type="button" data-item-add>${ic('plus')}Baris kosong</button>
            </div>
            <label class="disc"><span>Diskon</span><input class="in num" name="discount" inputmode="numeric" data-rp value="${v.discount ? rp(v.discount) : ''}" placeholder="0" /></label>
          </div>
        </section>
        <section class="sheet">
          <div class="sheet-h"><h2>Tanggal & ketentuan</h2></div>
          <div class="sheet-b grid" style="gap:1.25rem">
            <div class="grid g4">
              <div class="f"><span>Tanggal terbit <em>*</em></span>${datePick('issued_at', v.issued_at)}</div>
              ${kind === 'quotation' ? `<div class="f"><span>Berlaku sampai</span>${datePick('valid_until', v.valid_until, true)}</div>` : ''}
              ${kind === 'invoice' ? `<div class="f"><span>Jatuh tempo</span>${datePick('due_date', v.due_date, true)}</div>` : ''}
            </div>
            <label class="f"><span>Ketentuan — satu poin per baris, tercetak persis di PDF</span><textarea class="in" name="terms" rows="4">${esc(v.terms.join('\n'))}</textarea></label>
            <label class="f"><span>Catatan</span><textarea class="in" name="notes" rows="2">${esc(v.notes)}</textarea></label>
          </div>
        </section>
        <div class="dock">
          <span class="dock-tot"><span>Total</span><strong class="cond" data-total>Rp 0</strong></span>
          <a class="b b-ghost" href="${backHref}">Batal</a>
          <button class="b b-live" type="submit">${ic('check')}${d ? 'Simpan perubahan' : `Simpan ${LABEL[kind].toLowerCase()}`}</button>
        </div>
      </form>`;

    const form = $<HTMLFormElement>('[data-doc-form]');
    const items = $('[data-items]');
    const readItems = (): Item[] => [...items.querySelectorAll<HTMLElement>('[data-item]')].map((r) => ({
      name: $<HTMLInputElement>('[name=name]', r).value,
      includes: $<HTMLTextAreaElement>('[name=includes]', r).value.split('\n'),
      qty: parseQty($<HTMLInputElement>('[name=qty]', r).value),
      unit_price: parseRp($<HTMLInputElement>('[name=price]', r).value),
    }));
    const recalc = () => {
      items.querySelectorAll<HTMLElement>('[data-item]').forEach((r) => {
        $('[data-sum]', r).textContent = rp(parseQty($<HTMLInputElement>('[name=qty]', r).value) * parseRp($<HTMLInputElement>('[name=price]', r).value));
      });
      const doc = { items: readItems(), discount: parseRp((form.elements.namedItem('discount') as HTMLInputElement).value) };
      $('[data-total]').textContent = `Rp ${rp(total(doc))}`;
    };
    recalc();
    form.addEventListener('input', () => { dirty = true; recalc(); });
    $('[data-item-add]').addEventListener('click', () => { items.insertAdjacentHTML('beforeend', itemRow()); recalc(); $<HTMLInputElement>('[data-item]:last-child [name=name]', items).focus(); });
    items.addEventListener('click', (e) => {
      const del = (e.target as HTMLElement).closest('[data-item-del]');
      if (!del) return;
      del.closest('[data-item]')!.remove();
      if (!items.children.length) items.insertAdjacentHTML('beforeend', itemRow());
      dirty = true;
      recalc();
    });
    $('[data-pkg-menu]').addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLElement;
      openPop(btn.parentElement!, `<div class="menu" role="menu">${pkgs.map((p) => `<button type="button" role="menuitem" data-pkg="${p.id}"><span><b>${esc(p.name)}</b><span>${esc(p.includes.join(' · '))}</span></span><em class="cond">${rp(p.price)}</em></button>`).join('')}</div>`, (pop) => {
        pop.addEventListener('click', (ev) => {
          const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-pkg]');
          const p = pkgs.find((x) => x.id === b?.dataset.pkg);
          if (!p) return;
          // Baris kosong pertama diisi; kalau sudah terisi, tambah baris baru.
          const first = items.querySelector<HTMLElement>('[data-item]');
          const blank = first && items.children.length === 1 && !$<HTMLInputElement>('[name=name]', first).value.trim();
          if (blank) first.outerHTML = itemRow({ name: p.name, includes: p.includes, qty: 1, unit_price: p.price });
          else items.insertAdjacentHTML('beforeend', itemRow({ name: p.name, includes: p.includes, qty: 1, unit_price: p.price }));
          closePop();
          dirty = true;
          recalc();
        });
      });
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '';
      const doc = {
        issued_at: pickValue(form, 'issued_at'),
        valid_until: pickValue(form, 'valid_until'),
        due_date: pickValue(form, 'due_date'),
        client: { name: f('client.name'), attn: f('client.attn'), phone: f('client.phone'), email: f('client.email'), address: f('client.address') },
        event: { title: f('event.title'), date: pickValue(form, 'event.date'), time: f('event.time'), venue: f('event.venue'), city: f('event.city') },
        items: readItems(),
        discount: parseRp(f('discount')),
        terms: f('terms').split('\n'),
        notes: f('notes'),
      };
      const btn = form.querySelector<HTMLButtonElement>('[type=submit]');
      const id = d ? await act('doc.update', { id: d.id, doc }, btn) : await act('doc.create', { doc_type: kind, doc }, btn);
      if (id) { dirty = false; toast(d ? 'Perubahan tersimpan.' : `${LABEL[kind]} tersimpan.`); go(`#dokumen/${id}`); }
    });
  }

  // ---------- Pemilih tanggal (kontrol sendiri, bukan input date bawaan browser) ----------
  const addDays = (iso: string, n: number) => { const x = d8(iso); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };
  function datePick(name: string, value: string | null, optional = false) {
    return `<div class="pw"><button type="button" class="in pick${value ? '' : ' is-empty'}" data-date="${name}" data-value="${value ?? ''}" data-optional="${optional}"><span>${value ? fPick(value) : 'Pilih tanggal'}</span>${ic('cal')}</button></div>`;
  }
  const pickValue = (root: ParentNode, name: string) => root.querySelector<HTMLElement>(`[data-date="${name}"]`)?.dataset.value || null;
  function setPick(btn: HTMLElement, iso: string | null) {
    btn.dataset.value = iso ?? '';
    btn.firstElementChild!.textContent = iso ? fPick(iso) : 'Pilih tanggal';
    btn.classList.toggle('is-empty', !iso);
    dirty = true;
    btn.dispatchEvent(new Event('change', { bubbles: true }));
  }
  function openCalendar(btn: HTMLElement) {
    let view = (btn.dataset.value || data.today).slice(0, 7);
    const draw = (pop: HTMLElement) => {
      const [y, m] = view.split('-').map(Number) as [number, number];
      const first = new Date(Date.UTC(y, m - 1, 1));
      const lead = (first.getUTCDay() + 6) % 7; // minggu dimulai Senin
      const days = new Date(Date.UTC(y, m, 0)).getUTCDate();
      const cells = Array.from({ length: lead }, () => '<i></i>').concat(Array.from({ length: days }, (_, i) => {
        const iso = `${view}-${String(i + 1).padStart(2, '0')}`;
        return `<button type="button" data-day="${iso}" class="${iso === data.today ? 'is-today' : ''}${iso === btn.dataset.value ? ' is-sel' : ''}" aria-label="${fDate(iso)}">${i + 1}</button>`;
      }));
      pop.innerHTML = `<div class="cal-h"><button class="ib" type="button" data-mv="-1" aria-label="Bulan sebelumnya">${ic('left')}</button><span>${BULAN[m - 1]} ${y}</span><button class="ib" type="button" data-mv="1" aria-label="Bulan berikutnya">${ic('right')}</button></div>
        <div class="cal-g">${['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'].map((h) => `<span>${h}</span>`).join('')}${cells.join('')}</div>
        <div class="cal-f"><button class="b b-quiet b-sm" type="button" data-day="${data.today}">Hari ini</button>${btn.dataset.optional === 'true' ? '<button class="b b-quiet b-sm" type="button" data-clear>Kosongkan</button>' : ''}</div>`;
    };
    openPop(btn.parentElement!, '', (pop) => {
      draw(pop);
      pop.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const mv = t.closest<HTMLElement>('[data-mv]');
        if (mv) { const [y, m] = view.split('-').map(Number) as [number, number]; const n = new Date(Date.UTC(y, m - 1 + Number(mv.dataset.mv), 1)); view = n.toISOString().slice(0, 7); draw(pop); return; }
        const day = t.closest<HTMLElement>('[data-day]');
        if (day) { setPick(btn, day.dataset.day!); closePop(); btn.focus(); return; }
        if (t.closest('[data-clear]')) { setPick(btn, null); closePop(); btn.focus(); }
      });
    });
  }
  let pop: HTMLElement | null = null;
  function openPop(anchor: HTMLElement, html: string, init: (el: HTMLElement) => void) {
    const reopen = pop?.parentElement === anchor;
    closePop();
    if (reopen) return;
    pop = Object.assign(document.createElement('div'), { className: 'pop', innerHTML: html });
    anchor.append(pop);
    init(pop);
    // Jangan keluar layar kanan di HP.
    const r = pop.getBoundingClientRect();
    if (r.right > innerWidth - 8) pop.style.left = `${Math.min(0, innerWidth - 8 - r.right)}px`;
  }
  function closePop() { pop?.remove(); pop = null; }
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const pick = t.closest<HTMLElement>('[data-date]');
    if (pick) { openCalendar(pick); return; }
    // composedPath, bukan pop.contains: tombol bulan di kalender sudah diganti (digambar ulang)
    // saat event ini sampai, jadi tidak lagi "di dalam" pop.
    if (pop && !e.composedPath().includes(pop) && !t.closest('[data-pkg-menu]')) closePop();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && pop) closePop(); });
  // Textarea tumbuh mengikuti isi (cadangan untuk browser tanpa field-sizing, mis. Safari iOS).
  const grow = (t: HTMLTextAreaElement) => { if (CSS.supports('field-sizing', 'content')) return; t.style.height = 'auto'; t.style.height = `${t.scrollHeight + 2}px`; };
  new MutationObserver(() => main.querySelectorAll('textarea').forEach(grow)).observe(main, { childList: true, subtree: true });
  // Isian rupiah: titik ribuan otomatis saat diketik.
  document.addEventListener('input', (e) => {
    if (e.target instanceof HTMLTextAreaElement) grow(e.target);
    const el = e.target as HTMLInputElement;
    if (!el.matches?.('[data-rp]')) return;
    const n = parseRp(el.value);
    el.value = n ? rp(n) : '';
  });

  // ---------- Jadwal: rundown ----------
  function renderEvents(editId?: string) {
    const all = [...data.events].sort((a, b) => a.date.localeCompare(b.date) || (a.time ?? '').localeCompare(b.time ?? ''));
    const upcoming = all.filter((e) => e.date >= data.today);
    const past = all.filter((e) => e.date < data.today).reverse();
    const months = new Map<string, Ev[]>();
    for (const e of upcoming) months.set(e.date.slice(0, 7), [...(months.get(e.date.slice(0, 7)) ?? []), e]);
    const next = upcoming[0];
    const card = (e: Ev) => {
      if (editId === e.id && data.owner) return `<div class="sheet-b" style="border-top:1px solid var(--rule)">${evForm(e)}</div>`;
      const n = daysBetween(data.today, e.date);
      const when = n === 0 ? 'hari ini' : n === 1 ? 'besok' : n > 1 && n <= 7 ? `${n} hari lagi` : HARI[d8(e.date).getUTCDay()];
      const time = e.time?.match(/^\d{1,2}[.:]\d{2}/)?.[0];
      const inv = data.owner ? byId(e.doc_id) : null;
      const place = [e.venue, e.city].filter(Boolean).join(', ');
      return `<article class="row ev${n === 0 ? ' is-today' : ''}">
        ${slab(e.date, HARI[d8(e.date).getUTCDay()].slice(0, 3))}
        <span class="ev-time cond">${time ? esc(time.replace(':', '.')) : '<span class="soft" style="font-size:0.8125rem;font-weight:600">jam belum diisi</span>'}<small>${esc(when)}</small></span>
        <span class="row-main"><strong>${esc(e.title)}</strong><span>${esc([e.time && e.time !== time ? e.time : '', place].filter(Boolean).join(' · ') || 'tempat belum diisi')}</span></span>
        <span class="ev-side">${e.crew ? `<b>Crew</b>${esc(e.crew)}` : e.client && e.client !== e.title ? `<b>Klien</b>${esc(e.client)}` : ''}${inv ? `<br /><a class="soft" href="#dokumen/${inv.id}">${esc(inv.doc_number)}</a> · ${stat(inv)}` : ''}</span>
        ${data.owner ? `<a class="b b-ghost b-sm" href="#jadwal/${e.id}">${ic('edit')}Ubah</a>` : '<span></span>'}
        ${e.notes ? `<p class="ev-note">${esc(e.notes)}</p>` : ''}
      </article>`;
    };
    const nowLine = `<div class="now"><i></i>Sekarang · ${fDate(data.today)}</div>`;
    main.innerHTML = `
      <div class="ph">
        <div><h1 class="cond">Jadwal</h1><p class="lede">${next ? `Berikutnya <strong>${esc(next.title)}</strong>, ${daysBetween(data.today, next.date) === 0 ? '<span class="live">hari ini</span>' : fDate(next.date)}.` : 'Belum ada acara mendatang.'}</p></div>
        ${data.owner ? `<div class="ph-actions"><a class="b b-live" href="#jadwal/baru">${ic('plus')}Jadwal baru</a></div>` : ''}
      </div>
      ${editId === 'baru' && data.owner ? `<section class="sheet"><div class="sheet-h"><h2>Jadwal baru</h2></div><div class="sheet-b">${evForm(null)}</div></section>` : ''}
      ${[...months].map(([m, list], i) => `<section class="sheet">
        <div class="sheet-h"><h2>${BULAN[+m.slice(5) - 1]} ${m.slice(0, 4)}<small>${list.length} acara</small></h2></div>
        ${i === 0 ? nowLine : ''}
        <div class="rows">${list.map(card).join('')}</div></section>`).join('')
        || (editId === 'baru' ? '' : `<section class="sheet">${nowLine}<div class="empty"><p>Belum ada acara mendatang.</p><p>${data.owner ? 'Invoice yang tanggal acaranya diisi otomatis masuk ke sini.' : 'Acara baru muncul di sini begitu dijadwalkan.'}</p></div></section>`)}
      ${past.length ? `<details class="sheet past"${past.some((e) => e.id === editId) ? ' open' : ''}><summary>${ic('right')}Sudah lewat · ${past.length} acara</summary><div class="rows">${past.map(card).join('')}</div></details>` : ''}`;
    const form = main.querySelector<HTMLFormElement>('[data-ev-form]');
    if (!form) return;
    form.addEventListener('input', () => { dirty = true; });
    form.querySelector('[data-ev-del]')?.addEventListener('click', async () => {
      if (!(await confirmBox('Hapus jadwal ini?', 'Hapus'))) return;
      if ((await act('event.delete', { id: form.dataset.id })) !== null) { toast('Jadwal dihapus.'); dirty = false; go('#jadwal'); }
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const ev = Object.fromEntries(['title', 'time', 'client', 'venue', 'city', 'crew', 'notes'].map((k) => [k, fd.get(k)]));
      const id = await act('event.save', { event: { ...ev, id: form.dataset.id || undefined, date: pickValue(form, 'date') } }, form.querySelector<HTMLButtonElement>('[type=submit]'));
      if (id) { dirty = false; toast('Jadwal tersimpan.'); go('#jadwal'); }
    });
    form.querySelector<HTMLInputElement>('[name=title]')?.focus();
  }
  function evForm(e: Ev | null) {
    return `<form data-ev-form data-id="${e?.id ?? ''}" novalidate class="grid" style="gap:1.1rem">
      <div class="grid g3">
        <label class="f"><span>Nama acara <em>*</em></span><input class="in" name="title" value="${esc(e?.title)}" /></label>
        <div class="f"><span>Tanggal <em>*</em></span>${datePick('date', e?.date ?? null)}</div>
        <label class="f"><span>Jam</span><input class="in" name="time" value="${esc(e?.time)}" placeholder="mis. 17.00 – selesai" /></label>
        <label class="f"><span>Tempat</span><input class="in" name="venue" value="${esc(e?.venue)}" /></label>
        <label class="f"><span>Kota</span><input class="in" name="city" value="${esc(e?.city)}" /></label>
        <label class="f"><span>Klien</span><input class="in" name="client" value="${esc(e?.client)}" /></label>
        <label class="f s2"><span>Crew yang bertugas</span><input class="in" name="crew" value="${esc(e?.crew)}" placeholder="mis. Wahab (video), Arief (foto)" /></label>
      </div>
      <label class="f"><span>Catatan untuk crew</span><textarea class="in" name="notes" rows="2">${esc(e?.notes)}</textarea></label>
      <div style="display:flex;gap:0.5rem;justify-content:flex-end;flex-wrap:wrap">
        ${e ? '<button class="b b-danger" type="button" data-ev-del style="margin-right:auto">Hapus</button>' : ''}
        <a class="b b-ghost" href="#jadwal">Batal</a>
        <button class="b b-live" type="submit">${ic('check')}Simpan jadwal</button>
      </div>
    </form>`;
  }

  // ---------- Paket & harga ----------
  function renderPackages(editId?: string) {
    const list = data.packages ?? [];
    const active = list.filter((p) => p.active);
    const card = (p: Pkg, i: number) => editId === p.id ? `<div class="row" style="display:block;padding:0">${pkgForm(p)}</div>` : `<article class="row pk${p.active ? '' : ' is-off'}">
      <div class="row-main"><h3>${esc(p.name)}</h3>${p.includes.length ? `<ul>${p.includes.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''}</div>
      <div class="pk-price"><b class="cond">${rp(p.price)}</b>${p.active ? '' : `<small>${mark('disembunyikan', 'hl-p')}</small>`}</div>
      <div class="pk-act">
        <button class="ib" type="button" data-mv="${p.id}" data-dir="-1" aria-label="Naikkan urutan" title="Naikkan urutan" ${i === 0 ? 'disabled' : ''}>${ic('up')}</button>
        <button class="ib" type="button" data-mv="${p.id}" data-dir="1" aria-label="Turunkan urutan" title="Turunkan urutan" ${i === list.length - 1 ? 'disabled' : ''}>${ic('down')}</button>
        <a class="b b-ghost b-sm" href="#paket/${p.id}">${ic('edit')}Ubah</a>
      </div>
    </article>`;
    main.innerHTML = `
      <div class="ph">
        <div><h1 class="cond">Paket & harga</h1><p class="lede">${active.length ? `<strong>${active.length} paket aktif</strong>, mulai Rp ${rp(Math.min(...active.map((p) => p.price)))}.` : list.length ? 'Semua paket sedang disembunyikan.' : 'Belum ada paket.'}</p><p class="hint" style="margin-top:0.5rem">Muncul di tombol “Dari paket” saat membuat dokumen; harga per dokumen tetap bisa disesuaikan.</p></div>
        <div class="ph-actions"><a class="b b-live" href="#paket/baru">${ic('plus')}Paket baru</a></div>
      </div>
      ${editId === 'baru' ? `<section class="sheet">${pkgForm(null)}</section>` : ''}
      <section class="sheet"><div class="sheet-h"><h2>Daftar paket<small>${list.length} paket · urutan sama dengan menu “Dari paket”</small></h2></div>
        <div class="rows">${list.map(card).join('') || (editId === 'baru' ? '' : '<div class="empty"><p>Belum ada paket.</p><p>Tekan “Paket baru”.</p></div>')}</div></section>`;
    main.querySelectorAll<HTMLButtonElement>('[data-mv]').forEach((b) => b.addEventListener('click', async () => {
      if ((await act('package.move', { id: b.dataset.mv, dir: Number(b.dataset.dir) }, b)) !== null) route();
    }));
    const form = main.querySelector<HTMLFormElement>('[data-pkg-form]');
    if (!form) return;
    form.addEventListener('input', () => { dirty = true; });
    const sw = $<HTMLButtonElement>('[role=switch]', form);
    sw.addEventListener('click', () => sw.setAttribute('aria-checked', String(sw.getAttribute('aria-checked') !== 'true')));
    form.querySelector('[data-pkg-del]')?.addEventListener('click', async () => {
      if (!(await confirmBox('Hapus paket ini? Dokumen yang sudah dibuat tidak ikut berubah.', 'Hapus'))) return;
      if ((await act('package.delete', { id: form.dataset.id })) !== null) { dirty = false; toast('Paket dihapus.'); go('#paket'); }
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const id = await act('package.save', { package: {
        id: form.dataset.id || undefined, name: fd.get('name'), price: parseRp(String(fd.get('price'))),
        includes: String(fd.get('includes')).split('\n'), active: sw.getAttribute('aria-checked') === 'true',
      } }, form.querySelector<HTMLButtonElement>('[type=submit]'));
      if (id) { dirty = false; toast('Paket tersimpan.'); go('#paket'); }
    });
    form.querySelector<HTMLInputElement>('[name=name]')?.focus();
  }
  function pkgForm(p: Pkg | null) {
    return `<form data-pkg-form data-id="${p?.id ?? ''}" novalidate>
      <div class="sheet-h"><h2>${p ? 'Ubah paket' : 'Paket baru'}</h2></div>
      <div class="sheet-b grid" style="gap:1.1rem">
        <div class="grid g3">
          <label class="f s2"><span>Nama paket <em>*</em></span><input class="in" name="name" value="${esc(p?.name)}" placeholder="mis. Dokumentasi Foto & Video 2 Jam" /></label>
          <label class="f"><span>Harga (Rp) <em>*</em></span><input class="in num" name="price" inputmode="numeric" data-rp value="${p ? rp(p.price) : ''}" /></label>
        </div>
        <label class="f"><span>Isi paket — satu poin per baris</span><textarea class="in" name="includes" rows="4">${esc(p?.includes.join('\n'))}</textarea></label>
      </div>
      <div class="form-foot">
        <button type="button" class="switch spacer" role="switch" aria-checked="${p ? p.active : true}"><i></i>Tampil di menu “Dari paket”</button>
        ${p ? '<button class="b b-danger" type="button" data-pkg-del>Hapus</button>' : ''}
        <a class="b b-ghost" href="#paket">Batal</a>
        <button class="b b-live" type="submit">${ic('check')}Simpan paket</button>
      </div>
    </form>`;
  }

  // ---------- Mulai ----------
  $('[data-logout]').addEventListener('click', async () => {
    await fetch('/api/admin/login', { method: 'DELETE', credentials: 'same-origin' });
    location.href = '/admin';
  });
  fetch('/api/admin/login', { cache: 'no-store', credentials: 'same-origin' }).then((r) => r.json()).then((s) => {
    if (!s.loggedIn) { location.href = '/admin'; return; }
    $('[data-who]').textContent = s.profile?.name ?? '';
    load();
  }).catch(() => { main.innerHTML = '<div class="sheet empty"><p>Koneksi terputus.</p><p>Muat ulang halaman.</p></div>'; });
</script>
