---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import potret from '../assets/brand/foto-arief.jpg';
import { totals } from '../data/work';
import { clientLogos } from '../lib/images';
import { site, fullAddress, mapsUrl } from '../data/site';
import { services } from '../data/services';
import ServiceGrid from '../components/ServiceGrid.astro';
import { breadcrumb, business } from '../lib/seo';

const years = new Date().getFullYear() - Number(site.founded.slice(0, 4));
const schema = [
  breadcrumb([['Beranda', '/'], ['Tentang', '/about']]),
  { '@type': 'AboutPage', name: `Tentang ${site.name}`, url: new URL('/about', Astro.site).href, about: business },
];

const { videos: totalVideos, photos: totalPhotos } = totals;

// Angka diambil langsung dari isi portofolio, jadi selalu akurat saat karya bertambah.
const stats = [
  { value: `${totalVideos}`, label: 'Video dokumentasi' },
  { value: `${totalPhotos}`, label: 'Foto terpublikasi' },
  { value: `${clientLogos.length}`, label: 'Brand & institusi' },
  { value: `${services.length}`, label: 'Layanan' },
];
---

<Base
  title="Tentang Kami — Tim Foto & Video Dokumentasi Bogor"
  description={`${site.name} adalah tim fotografi dan videografi di Kota Bogor sejak 2021. ${totalVideos} proyek dan ${totalPhotos} foto untuk ${clientLogos.length}+ brand di Bogor, Jakarta, dan Jabodetabek.`}
  {schema}
>
  <section class="intro wrap">
    <div class="intro-copy">
      <p class="eyebrow">Tentang {site.name}</p>

      <h1 class="intro-title">Dokumentasi adalah seni memuliakan ingatan.</h1>

      <div class="intro-body">
        <p>
          {site.name} adalah tim fotografi dan sinematografi yang berdiri di Kota Bogor pada 24 Juni 2021.
          Kehangatan cerita pribadi, energi sebuah acara, hingga ambisi sebuah brand — semuanya kami rekam
          dengan teliti, supaya tetap hidup lama setelah momennya berlalu.
        </p>
        <p>
          Dalam {years > 1 ? `${years} tahun` : 'waktu singkat'} kami telah menggarap {totalVideos} proyek untuk
          {' '}{clientLogos.length}+ brand dan institusi — dari Samsung, Eiger, dan Pertamina Patra Niaga sampai
          Bank Indonesia dan Dinas Pariwisata Kota Bogor. Karya video promosi kami meraih juara 1 lomba video
          promosi wisata dan kuliner Kota Bogor.
        </p>
        <p>
          Kami satu keluarga dengan <a href={site.sister.url} target="_blank" rel="noopener">{site.sister.name}</a>,
          sehingga dokumentasi foto, video, dan photobooth acara Anda bisa ditangani oleh satu tim.
        </p>
        <p class="addr">
          <strong>Kantor:</strong> <a href={mapsUrl()} target="_blank" rel="noopener">{fullAddress()}</a><br />
          <strong>Area layanan:</strong> {site.areaServed.join(', ')}, dan luar kota.
        </p>
      </div>
    </div>

    <figure class="portrait">
      <Image
        src={potret}
        alt="Potret pendiri Tetra Visual"
        widths={[400, 640, 900]}
        sizes="(max-width: 900px) 70vw, 32vw"
        loading="eager"
      />
      {/* Ingin menambahkan nama & jabatan? Tulis di sini, mis:
          <figcaption>Nama — Founder & Director</figcaption> */}
    </figure>
  </section>

  <section class="wrap">
    <dl class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="stat-label">{s.label}</dt>
            <dd class="stat-value">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section wrap fields">
    <h2 class="fields-title">Yang kami kerjakan</h2>
    <ServiceGrid items={services} />
  </section>
</Base>

<style>
  /* Pembatas lebar di elemen dalam — .wrap memusatkan dirinya sendiri. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2rem, 5vw, 3rem);
  }
  .intro-copy { max-width: 46rem; }

  .portrait { margin: 0; }
  .portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius-lg);
  }

  /* Di layar sempit potret pindah ke bawah teks, tidak dipaksa berdampingan */
  @media (max-width: 900px) {
    .intro { grid-template-columns: 1fr; }
    .portrait { max-width: 22rem; }
  }

  .intro-title {
    font-size: var(--t-h1);
    margin-block: var(--s-4) var(--s-6);
  }

  .intro-body a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .addr { font-size: var(--t-sm); line-height: 1.7; }
  .intro-body {
    display: grid;
    gap: var(--s-4);
    max-width: 62ch;
    color: var(--text-dim);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.75;
  }

  /* --- ANGKA --- */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s-4);
    margin: 0;
    padding-block: var(--s-6);
    border-block: 1px solid var(--line);
  }

  .stat { display: flex; flex-direction: column-reverse; gap: var(--s-2); }

  .stat-value {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: var(--t-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* --- BIDANG LAYANAN --- */
  .fields-title { font-size: var(--t-h2); margin-bottom: var(--s-5); }

</style>
