---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Lightbox from '../components/Lightbox.astro';
import { categories, categoryBySlug, featuredProject, asset, totals } from '../data/work';
import { clientLogos } from '../lib/images';
import { site } from '../data/site';

// Karya unggulan yang tombolnya ada di hero — dipilih lewat centang "unggulan" di dashboard.
const featured = featuredProject;
const featuredCat = featured && categoryBySlug.get(featured.category);

// Urutan kategori diatur di data/work.ts (terkuat lebih dulu). Kategori kosong tidak tampil.
const rows = categories.filter((c) => c.projects.length > 0);

// Slideshow hero: hanya foto kamera asli (3000–6000px), bukan frame video 1920px yang pecah
// saat di-zoom. Bukan cover video juga — cover ada teks judulnya yang bertabrakan dengan tulisan hero.
// Yang pertama gelap supaya teks langsung terbaca saat halaman dibuka.
// Foto yang hilang (mis. proyeknya dihapus dari dashboard) otomatis dilewati.
const HERO_PHOTOS = [
  'work/event/photos/photo-28.jpg',
  'projects/wisuda-man-2-koto-bogor-tahun-2024/01.jpg',
  'projects/vitacimin/02.jpg',
  'work/event/photos/photo-37.jpg',
  'projects/sweet-17th-vanessa/04.jpg',
  'projects/wisuda-man-2-koto-bogor-tahun-2024/02.jpg',
  'work/event/photos/photo-36.jpg',
  'projects/vitacimin/03.jpg',
];
const heroSlides = HERO_PHOTOS.map(asset).filter(Boolean);

const { videos: totalVideos, photos: totalPhotos } = totals;
---

<Base
  title={site.name}
  description={`${site.description} Lebih dari ${totalVideos} video dan ${totalPhotos} foto dokumentasi untuk brand seperti Eiger, Samsung, Nutrifood, dan Pertamina.`}
  ogImage={featured?.cover}
  transparentHeader
>
  <!-- HERO: karya unggulan -->
  <section class="hero">
    {
      heroSlides.map((img, i) => (
        <Image
          class:list={['hero-bg', { 'is-active': i === 0 }]}
          src={img!}
          alt=""
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'low'}
        />
      ))
    }
    <div class="hero-veil"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">{site.tagline}</p>

        <h1 class="hero-title">Kami merekam yang layak dikenang.</h1>

        <p class="hero-lead">
          Tim fotografi dan videografi untuk corporate, event, dan olahraga.
          Dipercaya {clientLogos.length}+ brand — dari Eiger sampai Samsung.
        </p>

        {featured && (
          <div class="hero-actions">
            {featured.youtubeId && (
              <button class="btn btn-light" type="button" data-video-id={featured.youtubeId} data-video-title={featured.title}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
                Putar Karya Unggulan
              </button>
            )}
            <button class="btn btn-info" type="button" data-project={featured.slug} aria-haspopup="dialog">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 11v6M12 7.5v.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path></svg>
              Info Selengkapnya
            </button>
          </div>
        )}

        {featured && featuredCat && (
          <p class="hero-meta">
            <span class="hero-tag">{featuredCat.name}</span>
            <span class="hero-meta-text">{featured.title}</span>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- BARIS PER KATEGORI -->
  <div class="rows">
    {
      rows.map((cat, rowIndex) => (
        <Rail title={cat.name} href={`/work/${cat.slug}`} count={cat.projects.length}>
          {cat.projects.map((p, i) => (
            <VideoCard cover={p.cover} project={p.slug} title={p.title} desc={p.desc} eager={rowIndex === 0 && i < 3} />
          ))}
        </Rail>
      ))
    }
  </div>

  <!-- KLIEN -->
  <section class="section clients">
    <div class="wrap">
      <div class="clients-head">
        <p class="eyebrow clients-eyebrow">Dipercaya oleh</p>
        <h2 class="clients-title">Brand, Perusahaan & Komunitas</h2>
      </div>
      <ul class="clients-grid">
        {
          clientLogos.map((logo, i) => (
            <li class="client-card">
              <Image src={logo} alt={`Logo klien ${i + 1}`} widths={[240, 360, 480]} sizes="(max-width: 640px) 150px, 220px" loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ProjectModal />
  <VideoModal />
  <Lightbox />
</Base>

<script>
  // Ganti foto latar hero tiap 6 detik, berulang terus.
  const slides = document.querySelectorAll<HTMLElement>('.hero-bg');
  if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => {
      slides[i]!.classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i]!.classList.add('is-active');
    }, 6000);
  }
</script>

<style>
  /* --- HERO --- */
  .hero {
    position: relative;
    /* Tinggi dikunci ke layar supaya tombol & keterangan tidak terdorong ke bawah lipatan */
    min-height: min(88svh, 780px);
    display: flex;
    align-items: flex-end;
    /* tarik ke atas supaya berada di belakang header transparan */
    margin-top: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + var(--s-6)) clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;  /* subjek digeser ke kanan, teks dapat ruang di kiri */
    filter: brightness(0.82) saturate(1.05);
    opacity: 0;
    transition: opacity 1.5s var(--ease);
    /* Ken Burns: tiap foto zoom pelan sambil bergeser. Jalan terus (bukan hanya saat aktif)
       supaya tidak ada lompatan waktu foto memudar keluar. */
    animation: hero-kenburns 14s ease-in-out infinite alternate;
  }

  .hero-bg.is-active { opacity: 1; }

  /* Arah geser berbeda-beda per foto. Geser maks 3% × skala 1.18 < sisa tepi 9%, jadi tepi foto tak pernah terlihat. */
  .hero-bg:nth-of-type(4n + 1) { --kb-x: -3%; --kb-y: -2%; }
  .hero-bg:nth-of-type(4n + 2) { --kb-x: 3%;  --kb-y: 1%; }
  .hero-bg:nth-of-type(4n + 3) { --kb-x: -2%; --kb-y: 2%; }
  .hero-bg:nth-of-type(4n + 4) { --kb-x: 2%;  --kb-y: -2%; }

  @keyframes hero-kenburns {
    from { transform: scale(1.05); }
    to   { transform: scale(1.18) translate(var(--kb-x), var(--kb-y)); }
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg) 1%, rgba(35, 35, 35, 0.15) 40%, rgba(35, 35, 35, 0.45) 100%),
      linear-gradient(to right, rgba(35, 35, 35, 0.88) 0%, rgba(35, 35, 35, 0.5) 38%, transparent 68%);
  }

  /* .wrap memusatkan diri sendiri, jadi pembatas lebar teks harus di elemen di dalamnya —
     kalau tidak, blok teks ikut ke tengah, bukan rata kiri. */
  .hero-inner { position: relative; }
  .hero-copy { max-width: 34rem; }
  .hero-eyebrow { color: var(--text-dim); margin-bottom: var(--s-3); }

  .hero-title {
    font-size: var(--t-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
  }

  .hero-lead {
    margin-top: var(--s-4);
    max-width: 46ch;
    color: #dfe4e8;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
    font-size: var(--t-xs);
    color: var(--text-dim);
  }

  .hero-tag {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }

  /* Baris pertama sedikit menimpa hero — kesan berlapis khas Netflix */
  .rows {
    position: relative;
    z-index: 3;
    margin-top: clamp(-4rem, -5vw, -2rem);
  }

  /* --- KLIEN --- */
  .clients {
    border-top: 1px solid var(--line);
    margin-top: var(--s-8);
    padding-top: clamp(3.5rem, 7vw, 6rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .clients-head {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto var(--s-8);
  }

  .clients-eyebrow {
    margin-bottom: var(--s-2);
  }

  .clients-title {
    font-size: var(--t-h2);
    font-weight: 700;
    color: var(--text);
  }

  /* Grid logo yang rapi & proporsional:
     - 5 kolom di desktop (> 1080px): 29 logo tersusun 5-5-5-5-5-4 (baris terakhir 4 rata tengah)
     - 4 kolom di laptop/tablet landscape (820px - 1079px)
     - 3 kolom di tablet portrait (560px - 819px)
     - 2 kolom di HP (< 560px)
     Tiap kartu logo diberi bingkai halus (subtle tile) dengan padding lega,
     membuat logo dari berbagai proporsi (persegi, horizontal panjang, lambang)
     memiliki bobot optis yang seimbang dan terbaca jelas. */
  .clients-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1280px;
  }

  .client-card {
    flex: 0 0 calc((100% - 4 * clamp(0.75rem, 1.4vw, 1.25rem)) / 5);
    min-width: 170px;
    height: clamp(84px, 8vw, 100px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3) clamp(1rem, 2vw, 1.5rem);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: background-color 0.25s var(--ease), border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .client-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }

  .client-card :global(img) {
    width: auto;
    height: auto;
    max-width: clamp(120px, 13vw, 160px);
    max-height: clamp(40px, 4.5vw, 52px);
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.82;
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }

  .client-card:hover :global(img) {
    opacity: 1;
    transform: scale(1.04);
  }

  @media (max-width: 1080px) {
    .client-card {
      flex: 0 0 calc((100% - 3 * clamp(0.75rem, 1.4vw, 1.25rem)) / 4);
    }
  }

  @media (max-width: 820px) {
    .client-card {
      flex: 0 0 calc((100% - 2 * clamp(0.75rem, 1.4vw, 1.25rem)) / 3);
      min-width: 140px;
    }
  }

  @media (max-width: 560px) {
    .client-card {
      flex: 0 0 calc((100% - clamp(0.75rem, 1.4vw, 1.25rem)) / 2);
      min-width: 130px;
      height: 76px;
      padding: var(--s-2) var(--s-3);
    }
    .client-card :global(img) {
      max-width: 120px;
      max-height: 38px;
    }
  }

  @media (max-width: 700px) {
    .hero { min-height: 88svh; align-items: flex-end; }
    .hero-actions .btn { flex: 1 1 auto; }
  }
</style>
