---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import VideoCard from '../components/VideoCard.astro';
import VideoModal from '../components/VideoModal.astro';
import ProjectModal from '../components/ProjectModal.astro';
import Lightbox from '../components/Lightbox.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import { services } from '../data/services';

// Campuran layanan utama di beranda (semua layanan ada di /layanan).
const HOME_SERVICES = ['dokumentasi-event', 'video-company-profile', 'gathering-outing-kantor', 'dokumentasi-olahraga', 'paket-wedding', 'paket-prewedding', 'foto-wisuda', 'drone-aerial'];
import { categories, featuredProject, asset, totals, allProjects } from '../data/work';
import { clientLogos } from '../lib/images';
import { site, waLink } from '../data/site';
import ProcessSteps from '../components/ProcessSteps.astro';

// Karya unggulan yang tombolnya ada di hero — dipilih lewat centang "unggulan" di dashboard.
const featured = featuredProject;

// Kategori kosong tidak tampil. Beranda hanya menampilkan kartu kategori, bukan 8 baris penuh
// (riset NN/g: 74% perhatian habis di dua layar pertama — sisanya harus ringkas).
const cats = categories.filter((c) => c.projects.length > 0 && c.hero);

// "Karya terbaru" otomatis dari tanggal di dashboard, jadi beranda selalu terasa segar.
const newest = [...allProjects].sort((a, b) => (Date.parse(b.date ?? '') || 0) - (Date.parse(a.date ?? '') || 0)).slice(0, 10);

// Karya unggulan: pilihan terbaik lintas kategori (proyek yang dihapus otomatis terlewati).
const PICKS = [
  'samsung', 'mountain-jungle-course-2024', 'bulan-k3-nasional-pertamina-patra-niaga', 'qris-jelajah-indonesia',
  'ipb-half-marathon-2024', 'juara-1-promosi-wisata-kota-bogor', 'wedding-of-firly-bima', 'nutrifood',
  'fun-run-bank-indonesia-2025', 'jarambah-kampung-wisata', 'under-armor', 'sweet-17th-vanessa',
];
const picks = PICKS.map((slug) => allProjects.find((p) => p.slug === slug)).filter((p) => p !== undefined);

// Slideshow hero: hanya foto kamera asli (3000–6000px), bukan frame video 1920px yang pecah
// saat di-zoom. Bukan cover video juga — cover ada teks judulnya yang bertabrakan dengan tulisan hero.
// Yang pertama gelap supaya teks langsung terbaca saat halaman dibuka.
// Foto yang hilang (mis. proyeknya dihapus dari dashboard) otomatis dilewati.
const HERO_PHOTOS = [
  'work/event/photos/photo-28.jpg',
  'projects/wisuda-man-2-koto-bogor-tahun-2024/01.jpg',
  'projects/vitacimin/02.jpg',
  'work/event/photos/photo-37.jpg',
  'projects/sweet-17th-vanessa/04.jpg',
  'projects/wisuda-man-2-koto-bogor-tahun-2024/02.jpg',
  'work/event/photos/photo-36.jpg',
  'projects/vitacimin/03.jpg',
];
const heroSlides = HERO_PHOTOS.map(asset).filter(Boolean);

const { videos: totalVideos } = totals;
const svcBanner = asset('work/event/photos/photo-35.jpg');
const years = new Date().getFullYear() - Number(site.founded.slice(0, 4));
---

<Base
  title={`Jasa Foto & Video Dokumentasi Bogor & Jakarta — ${site.name}`}
  rawTitle
  description={`Jasa foto & video dokumentasi event, company profile, gathering, fun run, dan wedding di Bogor & Jakarta. ${totalVideos} proyek untuk Eiger, Samsung, Pertamina, dan Bank Indonesia.`}
  ogImage={featured?.cover}
  transparentHeader
>
  <!-- HERO: karya unggulan -->
  <section class="hero">
    {
      heroSlides.map((img, i) => (
        <Image
          class:list={['hero-bg', { 'is-active': i === 0 }]}
          src={img!}
          alt=""
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'low'}
        />
      ))
    }
    <div class="hero-veil"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <!-- H1 memuat kata kunci (dibaca Google) lewat label kecil; tampilan judul besar tetap. -->
        <h1 class="hero-h1">
          <span class="eyebrow hero-eyebrow">Jasa Foto &amp; Video Dokumentasi · Bogor &amp; Jakarta</span>
          <span class="hero-title">Foto &amp; video yang membuat acara Anda dikenang.</span>
        </h1>

        <p class="hero-lead">
          Dokumentasi event, perusahaan, olahraga, hingga pernikahan — oleh tim dari Bogor yang dipercaya
          Samsung, Eiger, Pertamina, dan Bank Indonesia.
        </p>

        <!-- Satu tujuan utama: chat WhatsApp. Tombol kedua untuk yang ingin melihat bukti dulu. -->
        <div class="hero-actions">
          <a class="btn btn-brand hero-cta" href={waLink('Halo Tetra Visual, saya ingin konsultasi untuk dokumentasi acara saya.')} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Z"></path></svg>
            Konsultasi via WhatsApp
          </a>
          {featured?.youtubeId && (
            <button class="btn btn-info" type="button" data-video-id={featured.youtubeId} data-video-title={featured.title}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
              Tonton Karya
            </button>
          )}
        </div>

        <p class="hero-proof">
          <span><strong>{totalVideos}</strong> proyek</span>
          <span><strong>{clientLogos.length}+</strong> brand &amp; institusi</span>
          <span>sejak <strong>{site.founded.slice(0, 4)}</strong></span>
        </p>

      </div>
    </div>
  </section>

  <!-- LAYAR KEDUA: karya terbaru (bukti + rasa penasaran) lalu logo klien -->
  <div class="rows">
    <Rail title="Karya terbaru" href="/work" hrefLabel="Semua karya" count={newest.length}>
      {newest.map((p, i) => <VideoCard cover={p.cover} project={p.slug} title={p.title} desc={p.desc} date={p.date} eager={i < 3} />)}
    </Rail>
  </div>

  <section class="logos" aria-label="Dipercaya oleh" data-reveal>
    <p class="eyebrow logos-eyebrow">Dipercaya {clientLogos.length}+ brand, instansi &amp; komunitas</p>
    <div class="logos-track">
      {[0, 1].map((copy) => (
        <ul class="logos-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {clientLogos.map((logo, i) => (
            <li><Image src={logo} alt={copy === 0 ? `Logo klien ${i + 1}` : ''} widths={[240]} sizes="140px" loading="lazy" /></li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- LAYANAN: banner pembuka + kartu -->
  <section class="svc-banner" aria-labelledby="svc-banner-title">
    {svcBanner && <Image class="svc-banner-bg" src={svcBanner} alt="" widths={[768, 1280, 1920, 2560]} sizes="100vw" loading="lazy" />}
    <div class="svc-banner-veil"></div>
    <div class="wrap svc-banner-inner" data-reveal>
      <p class="eyebrow svc-banner-eyebrow"><span></span>Layanan kami</p>
      <h2 id="svc-banner-title" class="svc-banner-title">Satu tim untuk setiap momen — dari panggung sampai pelaminan.</h2>
      <p class="svc-banner-lead">
        Foto, video, drone, live streaming, hingga photobooth. Anda cukup menceritakan acaranya, sisanya kami yang urus.
      </p>
      <dl class="svc-stats">
        <div><dt>Tahun berkarya</dt><dd>{years}+</dd></div>
        <div><dt>Proyek terdokumentasi</dt><dd>{totalVideos}</dd></div>
        <div><dt>Brand &amp; institusi</dt><dd>{clientLogos.length}+</dd></div>
        <div><dt>Layanan</dt><dd>{services.length}</dd></div>
      </dl>
      <div class="svc-banner-actions">
        <a class="btn btn-light" href="/layanan">Lihat semua layanan</a>
        <a class="btn btn-info" href="/kontak">Konsultasi gratis</a>
      </div>
    </div>
  </section>

  <section class="wrap home-svc" data-reveal>
    <div class="home-head">
      <h2 class="home-title">Apa yang bisa kami kerjakan</h2>
      <a class="home-more" href="/layanan">Semua layanan <span aria-hidden="true">→</span></a>
    </div>
    <ServiceGrid items={HOME_SERVICES.map((slug) => services.find((x) => x.slug === slug)!).filter(Boolean)} />
  </section>

  <!-- KARYA UNGGULAN + JELAJAH PER KATEGORI -->
  <div data-reveal>
    <Rail title="Karya unggulan" href="/work" hrefLabel="Semua karya" count={picks.length}>
      {picks.map((p) => <VideoCard cover={p.cover} project={p.slug} title={p.title} desc={p.desc} date={p.date} />)}
    </Rail>
  </div>

  <section class="wrap cats" data-reveal>
    <h2 class="home-title">Jelajahi karya per kategori</h2>
    <ul class="cats-grid">
      {cats.map((c) => (
        <li>
          <a class="cat" href={`/work/${c.slug}`}>
            <Image src={c.hero!} alt={`Dokumentasi ${c.name} oleh ${site.name}`} widths={[400, 640]} sizes="(max-width: 700px) 50vw, 25vw" loading="lazy" />
            <span class="cat-veil"></span>
            <span class="cat-text">
              <span class="cat-name">{c.name}</span>
              <span class="cat-count">{c.projects.length} proyek</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- PROFIL SINGKAT: teks yang dibaca Google untuk memahami bisnis ini -->
  <section class="wrap home-about" data-reveal>
    <h2 class="home-title">Jasa foto &amp; video dokumentasi di Bogor sejak 2021</h2>
    <div class="home-about-body">
      <p>
        {site.name} adalah tim fotografi dan videografi yang berbasis di Kota Bogor. Sejak 2021 kami telah
        menggarap {totalVideos} proyek — dari grand opening Samsung, event Eiger Adventure di Gunung Rinjani,
        Bulan K3 Pertamina Patra Niaga, hingga fun run Bank Indonesia — untuk {clientLogos.length}+ brand dan institusi.
      </p>
      <p>
        Karya video promosi kami meraih juara 1 lomba video promosi wisata dan kuliner Kota Bogor. Kami melayani
        {' '}{site.areaServed.join(', ')}, serta acara di luar kota, dan satu keluarga dengan
        {' '}<a href={site.sister.url} target="_blank" rel="noopener">{site.sister.name}</a> untuk kebutuhan photobooth.
      </p>
      <a class="btn btn-ghost" href="/about">Kenali kami lebih jauh</a>
    </div>
  </section>

  <div data-reveal><ProcessSteps /></div>

  <Testimonials />

  <ProjectModal />
  <VideoModal />
  <Lightbox />
</Base>

<script>
  // Ganti foto latar hero tiap 6 detik, berulang terus.
  const slides = document.querySelectorAll<HTMLElement>('.hero-bg');
  if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => {
      slides[i]!.classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i]!.classList.add('is-active');
    }, 6000);
  }
</script>

<style>
  /* --- HERO --- */
  .hero {
    position: relative;
    /* Tinggi dikunci ke layar supaya tombol & keterangan tidak terdorong ke bawah lipatan */
    min-height: min(88svh, 780px);
    display: flex;
    align-items: flex-end;
    /* tarik ke atas supaya berada di belakang header transparan */
    margin-top: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + var(--s-6)) clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;  /* subjek digeser ke kanan, teks dapat ruang di kiri */
    filter: brightness(0.82) saturate(1.05);
    opacity: 0;
    transition: opacity 1.5s var(--ease);
    /* Ken Burns: tiap foto zoom pelan sambil bergeser. Jalan terus (bukan hanya saat aktif)
       supaya tidak ada lompatan waktu foto memudar keluar. */
    animation: hero-kenburns 14s ease-in-out infinite alternate;
  }

  .hero-bg.is-active { opacity: 1; }

  /* Arah geser berbeda-beda per foto. Geser maks 3% × skala 1.18 < sisa tepi 9%, jadi tepi foto tak pernah terlihat. */
  .hero-bg:nth-of-type(4n + 1) { --kb-x: -3%; --kb-y: -2%; }
  .hero-bg:nth-of-type(4n + 2) { --kb-x: 3%;  --kb-y: 1%; }
  .hero-bg:nth-of-type(4n + 3) { --kb-x: -2%; --kb-y: 2%; }
  .hero-bg:nth-of-type(4n + 4) { --kb-x: 2%;  --kb-y: -2%; }

  @keyframes hero-kenburns {
    from { transform: scale(1.05); }
    to   { transform: scale(1.18) translate(var(--kb-x), var(--kb-y)); }
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg) 1%, rgba(35, 35, 35, 0.15) 40%, rgba(35, 35, 35, 0.45) 100%),
      linear-gradient(to right, rgba(35, 35, 35, 0.88) 0%, rgba(35, 35, 35, 0.5) 38%, transparent 68%);
  }

  /* .wrap memusatkan diri sendiri, jadi pembatas lebar teks harus di elemen di dalamnya —
     kalau tidak, blok teks ikut ke tengah, bukan rata kiri. */
  .hero-inner { position: relative; }
  .hero-copy { max-width: 34rem; }
  .hero-h1 { margin: 0; }
  .hero-eyebrow { display: block; color: var(--text-dim); margin-bottom: var(--s-3); line-height: 1.5; }

  .hero-title {
    display: block;
    font-size: var(--t-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
  }

  .hero-lead {
    margin-top: var(--s-4);
    max-width: 46ch;
    color: #dfe4e8;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }



  /* Baris pertama sedikit menimpa hero — kesan berlapis khas Netflix */
  .rows {
    position: relative;
    z-index: 3;
    margin-top: clamp(-4rem, -5vw, -2rem);
  }

  .hero-proof { display: flex; flex-wrap: wrap; gap: 0.35rem 0; }
  .hero-proof span + span::before { content: '·'; margin: 0 0.6rem; opacity: 0.6; }
  .hero-proof { margin-top: var(--s-5); font-size: var(--t-sm); color: var(--text-dim); text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7); }
  .hero-proof strong { color: #fff; font-weight: 700; }
  .hero-cta { box-shadow: 0 10px 30px rgba(229, 9, 20, 0.35); }

  /* --- LOGO KLIEN BERJALAN --- */
  .logos { padding-block: var(--s-6) var(--s-4); overflow: hidden; }
  .logos-eyebrow { text-align: center; margin-bottom: var(--s-5); }
  .logos-track {
    display: flex;
    width: max-content;
    animation: logos-run 60s linear infinite;
    -webkit-mask: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .logos:hover .logos-track { animation-play-state: paused; }
  .logos-list { display: flex; align-items: center; gap: clamp(2.5rem, 5vw, 4.5rem); list-style: none; margin: 0; padding: 0 clamp(1.25rem, 2.5vw, 2.25rem); }
  .logos-list :global(img) { width: auto; height: auto; max-width: 130px; max-height: 44px; object-fit: contain; filter: brightness(0) invert(1); opacity: 0.7; transition: opacity 0.2s; }
  .logos-list li:hover :global(img) { opacity: 1; }
  @keyframes logos-run { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .logos-track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; -webkit-mask: none; mask: none; }
    .logos-list[aria-hidden] { display: none; }
    .logos-list { flex-wrap: wrap; justify-content: center; row-gap: var(--s-5); }
  }

  /* --- KATEGORI --- */
  .cats { padding-block: var(--s-6) var(--s-8); }
  .cats .home-title { margin-bottom: var(--s-5); }
  .cats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-3); list-style: none; margin: 0; padding: 0; }
  .cat { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-elev); }
  .cat :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.32, 0.72, 0, 1), filter 0.3s; }
  .cat:hover :global(img) { transform: scale(1.07); filter: brightness(1.1); }
  .cat-veil { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.1) 60%); }
  .cat-text { position: absolute; left: var(--s-4); right: var(--s-4); bottom: var(--s-4); display: grid; gap: 0.1rem; }
  .cat-name { font-size: clamp(1.05rem, 1.6vw, 1.35rem); font-weight: 800; letter-spacing: -0.02em; }
  .cat-count { font-size: var(--t-xs); color: var(--text-dim); letter-spacing: 0.06em; }
  @media (max-width: 700px) { .cats-grid { grid-template-columns: repeat(2, 1fr); } }

  /* --- BANNER LAYANAN --- */
  .svc-banner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(78svh, 720px);
    margin-top: var(--s-9);
    padding-block: var(--s-9);
    overflow: hidden;
    isolation: isolate;
  }
  .svc-banner-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.62) saturate(1.1);
    animation: svc-drift 24s ease-in-out infinite alternate;
  }
  @keyframes svc-drift { from { transform: scale(1.04); } to { transform: scale(1.14) translate(-1.5%, -1%); } }
  /* Tepi atas & bawah melebur ke latar halaman; kiri gelap supaya teks terbaca */
  .svc-banner-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, var(--bg) 0%, rgba(35, 35, 35, 0) 22%, rgba(35, 35, 35, 0) 70%, var(--bg) 100%),
      linear-gradient(to right, rgba(20, 20, 20, 0.92) 0%, rgba(20, 20, 20, 0.55) 45%, rgba(20, 20, 20, 0.1) 80%);
  }
  .svc-banner-inner > * { max-width: 44rem; }
  .svc-banner-eyebrow { display: flex; align-items: center; gap: var(--s-3); color: #fff; }
  .svc-banner-eyebrow span { width: 2.5rem; height: 2px; background: var(--brand); }
  .svc-banner-title {
    margin-top: var(--s-4);
    font-size: clamp(2rem, 4.6vw, 3.75rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }
  .svc-banner-lead { margin-top: var(--s-5); max-width: 36rem; color: #e2e2e2; font-size: clamp(1rem, 1.3vw, 1.125rem); line-height: 1.7; }
  .svc-stats { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: var(--s-7); margin: var(--s-7) 0 0; }
  /* Angka di atas, sejajar walau labelnya patah dua baris */
  .svc-stats div { display: flex; flex-direction: column; gap: var(--s-1); }
  .svc-stats dd { order: -1; margin: 0; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .svc-stats dt { font-size: var(--t-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-dim); }
  .svc-banner-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-7); }
  .home-svc { padding-top: var(--s-4); padding-bottom: var(--s-9); }
  /* HP: kartu layanan jadi baris geser ke samping, bukan 8 kartu panjang ke bawah */
  @media (max-width: 640px) {
    .home-svc :global(.svc-grid) {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .home-svc :global(.svc-grid::-webkit-scrollbar) { display: none; }
    .home-svc :global(.svc-grid > li) { flex: 0 0 78%; scroll-snap-align: start; }
  }
  @media (max-width: 700px) {
    .svc-banner { min-height: 0; padding-block: var(--s-9) var(--s-8); }
    .svc-stats { grid-template-columns: repeat(2, auto); gap: var(--s-5) var(--s-7); }
    .svc-banner-actions .btn { flex: 1 1 auto; }
  }

  /* --- LAYANAN & PROFIL --- */
  .home-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-4); margin-bottom: var(--s-6); }
  .home-title { font-size: var(--t-h2); margin-top: var(--s-2); }
  .home-more { flex: none; font-size: var(--t-sm); font-weight: 500; color: var(--text-dim); transition: color 0.2s var(--ease); }
  .home-more:hover { color: var(--brand-hi); }
  .home-about { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(2rem, 6vw, 5rem); padding-bottom: var(--s-8); }
  .home-about-body { display: grid; gap: var(--s-4); justify-items: start; color: var(--text-dim); line-height: 1.8; }
  .home-about-body a:not(.btn) { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
