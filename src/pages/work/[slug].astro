---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Rail from '../../components/Rail.astro';
import VideoCard from '../../components/VideoCard.astro';
import VideoModal from '../../components/VideoModal.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import ProjectModal from '../../components/ProjectModal.astro';
import { categories } from '../../data/work';
import { site, waLink } from '../../data/site';

// Satu halaman dibuat otomatis untuk tiap kategori — tidak ada lagi 8 file HTML terpisah.
export function getStaticPaths() {
  return categories.map((cat) => ({ params: { slug: cat.slug }, props: { cat } }));
}

const { cat } = Astro.props;
const photos = cat.photos;
// Tombol Putar di hero memakai proyek pertama yang sudah punya video.
const lead = cat.projects.find((p) => p.youtubeId) ?? cat.projects[0];
// Latar hero pakai foto (bebas teks), bukan cover video.
const heroImg = cat.hero;
// Cover video tetap dipakai untuk gambar pratinjau saat link dishare.
const shareImg = lead?.cover ?? heroImg;

const others = categories.filter((c) => c.slug !== cat.slug);
---

<Base
  title={`Portofolio ${cat.name} — Foto & Video Dokumentasi Bogor`}
  description={`${cat.blurb} ${cat.projects.length} video dan ${photos.length} foto dokumentasi ${cat.name.toLowerCase()} oleh ${site.name}.`}
  ogImage={shareImg}
  transparentHeader={Boolean(heroImg)}
>
  {/* HERO KATEGORI */}
  {
    heroImg && lead && (
      <section class="chero">
        <Image class="chero-bg" src={heroImg} alt="" widths={[768, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
        <div class="chero-veil" />

        <div class="wrap chero-inner">
          <div class="chero-copy">
            <nav class="crumb" aria-label="Remah roti">
              <a href="/work">Work</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{cat.name}</span>
            </nav>

            <h1 class="chero-title">{cat.name}</h1>
            <p class="chero-blurb">{cat.blurb}</p>

            <div class="chero-actions">
              {lead.youtubeId && (
                <button class="btn btn-light" type="button" data-video-id={lead.youtubeId} data-video-title={lead.title}>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                  Putar Video
                </button>
              )}
              <a
                class="btn btn-ghost"
                href={waLink(`Halo Tetra Visual, saya tertarik dengan dokumentasi ${cat.name}. Boleh minta info paket dan jadwalnya?`)}
                target="_blank"
                rel="noopener"
              >
                Tanya Paket {cat.name}
              </a>
            </div>

            <p class="chero-stats">
              {cat.projects.length} video · {photos.length} foto
            </p>
          </div>
        </div>
      </section>
    )
  }

  {/* VIDEO */}
  {
    cat.projects.length > 0 && (
      <div class="stack">
        <Rail title="Video Dokumentasi" count={cat.projects.length}>
          {cat.projects.map((p, i) => (
            <VideoCard cover={p.cover} project={p.slug} title={p.title} desc={p.desc} eager={i < 3} />
          ))}
        </Rail>
      </div>
    )
  }

  {/* FOTO */}
  {
    photos.length > 0 && (
      <section class="section wrap">
        <div class="sec-head">
          <h2 class="sec-title">Galeri Foto</h2>
          <p class="sec-note">Klik foto untuk memperbesar</p>
        </div>
        <PhotoGrid photos={photos} label={cat.name.toLowerCase()} />
      </section>
    )
  }

  {/* KATEGORI LAIN */}
  <section class="section wrap other">
    <h2 class="sec-title">Kategori Lain</h2>
    <ul class="other-list">
      {others.map((c) => <li><a href={`/work/${c.slug}`}>{c.name}</a></li>)}
    </ul>
  </section>

  <ProjectModal only={cat.slug} />
  <VideoModal />
  <Lightbox />
</Base>

<style>
  .chero {
    position: relative;
    min-height: min(72svh, 720px);
    display: flex;
    align-items: flex-end;
    margin-top: calc(var(--header-h) * -1);
    padding-block: var(--s-9) clamp(2rem, 5vw, 3.5rem);
    overflow: hidden;
  }

  .chero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8) saturate(1.05);
  }

  .chero-veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg) 1%, rgba(35, 35, 35, 0.15) 40%, rgba(35, 35, 35, 0.45) 100%),
      linear-gradient(to right, rgba(35, 35, 35, 0.88) 0%, rgba(35, 35, 35, 0.5) 38%, transparent 68%);
  }

  /* Pembatas lebar harus di elemen dalam, karena .wrap memusatkan dirinya sendiri. */
  .chero-inner { position: relative; }
  .chero-copy { max-width: 34rem; }

  .crumb {
    display: flex;
    gap: var(--s-2);
    font-size: var(--t-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: var(--s-4);
  }
  .crumb a { transition: color 0.2s var(--ease); }
  .crumb a:hover { color: var(--brand-hi); }

  .chero-title {
    font-size: var(--t-display);
    font-weight: 800;
    letter-spacing: -0.035em;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
  }

  .chero-blurb {
    margin-top: var(--s-4);
    max-width: 50ch;
    color: #dfe4e8;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);
  }

  .chero-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  .chero-stats {
    margin-top: var(--s-5);
    font-size: var(--t-sm);
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .stack { position: relative; z-index: 3; margin-top: clamp(-3rem, -4vw, -1.5rem); }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-5);
  }
  .sec-title { font-size: var(--t-h2); }
  .sec-note { font-size: var(--t-sm); color: var(--text-faint); }

  .other { border-top: 1px solid var(--line); }
  .other-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
  }
  .other-list a {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--text-dim);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .other-list a:hover {
    color: var(--text);
    border-color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  @media (max-width: 700px) {
    .chero-actions .btn { flex: 1 1 auto; }
  }
</style>
