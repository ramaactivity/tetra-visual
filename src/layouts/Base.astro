---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site, mapsUrl, waLink } from '../data/site';
import logoFile from '../assets/brand/logo-tetra-master.png';
import { founders } from '../data/team';
import { clip } from '../lib/seo';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { featuredProject } from '../data/work';
import brandPreview from '../assets/brand/gambar-preview.jpg';

// Pratinjau share bawaan: cover karya unggulan (bisa diganti dari dashboard).
const defaultOg = featuredProject?.cover ?? brandPreview;

interface Props {
  title: string;
  description?: string;
  /** Gambar pratinjau saat link dishare ke WhatsApp / Instagram / Facebook. */
  ogImage?: ImageMetadata;
  /** Sembunyikan latar gelap header di halaman yang punya hero fullscreen. */
  transparentHeader?: boolean;
  /** Data terstruktur tambahan khusus halaman ini (Service, VideoObject, Breadcrumb, FAQ…). */
  schema?: Record<string, unknown>[];
  /** Judul lengkap apa adanya, tanpa akhiran " — Tetra Visual". */
  rawTitle?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = defaultOg,
  transparentHeader = false,
  schema = [],
  rawTitle = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Deskripsi > ±160 karakter terpotong di Google.
const metaDescription = clip(description, 158);

// Bikin versi kecil untuk pratinjau share (1200x630 standar Open Graph).
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

// Judul > ±60 karakter terpotong di Google: nama merek hanya ditambahkan bila masih muat.
const fullTitle = rawTitle || title.length + site.name.length + 3 > 62 ? title : `${title} | ${site.name}`;

// Data terstruktur supaya Google menampilkan Tetra sebagai bisnis lokal di Bogor.
// Nama, alamat, dan nomor harus sama persis dengan Google Business Profile.
const logo = await getImage({ src: logoFile, width: 512, format: 'png' });
const home = Astro.site!.href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${home}#bisnis`,
      name: site.name,
      description: site.description,
      url: home,
      logo: new URL(logo.src, Astro.site).href,
      image: ogUrl.href,
      email: site.email,
      telephone: `+${site.whatsapp}`,
      foundingDate: site.founded,
      founder: founders.map((f) => ({ '@type': 'Person', name: f.name, jobTitle: f.role })),
      // Tidak ada jam buka tetap (menyesuaikan acara) — yang tetap adalah jam admin WhatsApp.
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: `+${site.whatsapp}`,
        availableLanguage: ['id', 'en'],
        hoursAvailable: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: site.adminHours.opens,
          closes: site.adminHours.closes,
        },
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: 'ID',
      },
      areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
      hasMap: mapsUrl(),
      sameAs: [...site.social.map((s) => s.href), site.sister.url],
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <!-- Verifikasi Google Search Console (cadangan selain file public/google99c30cf8ec0159b9.html) -->
    <meta name="google-site-verification" content="C05ZgMXVkU5C9efisJ3791vqxjkjgc-nFtkhqvdopEg" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#232323" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- YouTube baru dihubungi saat video diputar, tapi koneksinya disiapkan lebih awal -->
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    {Astro.url.pathname === '/' && <Intro />}
    <a class="skip-link" href="#main">Lewati ke konten utama</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- WhatsApp selalu terjangkau di HP (muncul setelah pengunjung mulai menggulir) -->
    <a class="wa-float" data-wa-float href={waLink('Halo Tetra Visual, saya ingin bertanya tentang jasa dokumentasi.')} target="_blank" rel="noopener" aria-label="Chat WhatsApp Tetra Visual">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.13c-.25.69-1.44 1.32-1.99 1.37-.53.05-1.02.24-3.45-.72-2.91-1.15-4.75-4.15-4.89-4.34-.14-.2-1.16-1.55-1.16-2.95s.73-2.09.99-2.38c.26-.29.57-.36.76-.36l.55.01c.18.01.41-.07.64.49.24.57.8 1.97.87 2.11.07.15.12.32.02.51-.09.19-.14.31-.28.48l-.42.49c-.14.14-.29.29-.12.57.16.29.73 1.2 1.56 1.94 1.07.96 1.98 1.25 2.26 1.39.28.14.45.12.61-.07.17-.19.71-.83.9-1.11.19-.29.38-.24.64-.14.26.09 1.65.78 1.94.92.28.14.47.21.54.33.07.12.07.69-.18 1.36Z"></path></svg>
    </a>

    <script is:inline>
      (() => {
        const wa = document.querySelector('[data-wa-float]');
        if (wa) {
          const sync = () => wa.classList.toggle('is-on', scrollY > 500);
          addEventListener('scroll', sync, { passive: true });
          sync();
        }
        const items = document.querySelectorAll('[data-reveal]');
        if (!items.length || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px' });
        items.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
