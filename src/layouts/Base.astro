---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { featuredProject } from '../data/work';
import brandPreview from '../assets/brand/gambar-preview.jpg';

// Pratinjau share bawaan: cover karya unggulan (bisa diganti dari dashboard).
const defaultOg = featuredProject?.cover ?? brandPreview;

interface Props {
  title: string;
  description?: string;
  /** Gambar pratinjau saat link dishare ke WhatsApp / Instagram / Facebook. */
  ogImage?: ImageMetadata;
  /** Sembunyikan latar gelap header di halaman yang punya hero fullscreen. */
  transparentHeader?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = defaultOg,
  transparentHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

// Bikin versi kecil untuk pratinjau share (1200x630 standar Open Graph).
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;

// Data terstruktur supaya Google menampilkan Tetra sebagai bisnis, bukan halaman biasa.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  url: Astro.site?.href,
  image: ogUrl.href,
  email: site.email,
  telephone: `+${site.whatsapp}`,
  address: { '@type': 'PostalAddress', addressCountry: 'ID' },
  sameAs: site.social.map((s) => s.href),
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#232323" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- YouTube baru dihubungi saat video diputar, tapi koneksinya disiapkan lebih awal -->
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <Intro />
    <a class="skip-link" href="#main">Lewati ke konten utama</a>
    <Header transparent={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
