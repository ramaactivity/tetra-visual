---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: ImageMetadata[];
  /** Dipakai untuk teks alt: "Dokumentasi corporate oleh Tetra Visual" */
  label: string;
}
const { photos, label } = Astro.props;
---

<div class="grid">
  {
    photos.map((photo, i) => (
      <button
        class="cell"
        type="button"
        data-lightbox-item
        data-full={photo.src}
        aria-label={`Perbesar foto ${i + 1} dari ${photos.length}`}
      >
        <Image
          src={photo}
          alt={`Dokumentasi ${label} oleh Tetra Visual — foto ${i + 1}`}
          widths={[320, 480, 720]}
          sizes="(max-width: 560px) 50vw, (max-width: 1000px) 33vw, 25vw"
          loading={i < 8 ? 'eager' : 'lazy'}
        />
      </button>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--s-3);
  }

  .cell {
    position: relative;
    padding: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-elev);
    transition: transform 0.3s var(--ease);
  }

  .cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease), filter 0.3s var(--ease);
  }

  .cell:hover { transform: translateY(-3px); z-index: 2; }
  .cell:hover :global(img),
  .cell:focus-visible :global(img) { transform: scale(1.05); filter: brightness(1.08); }

  @media (max-width: 560px) {
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--s-2); }
  }
</style>
