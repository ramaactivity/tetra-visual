---
import { process } from '../data/services';
---

<section class="section wrap steps">
  <p class="eyebrow">Cara kerja</p>
  <h2 class="steps-title">Empat langkah, tanpa ribet</h2>
  <ol class="steps-list">
    {
      process.map(([name, text], i) => (
        <li>
          <span class="steps-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{name}</h3>
          <p>{text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps-title { font-size: var(--t-h2); margin: var(--s-2) 0 var(--s-6); }
  .steps-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: var(--s-4); list-style: none; margin: 0; padding: 0; counter-reset: none; }
  .steps-list li { padding: var(--s-5); border-radius: var(--radius-lg); background: var(--bg-elev); border: 1px solid var(--line); }
  .steps-num { font-size: 0.875rem; font-weight: 800; color: var(--brand-hi); letter-spacing: 0.1em; }
  .steps-list h3 { font-size: 1.0625rem; margin: var(--s-3) 0 var(--s-2); }
  .steps-list p { font-size: var(--t-sm); color: var(--text-dim); line-height: 1.6; }
</style>
