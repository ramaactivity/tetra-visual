---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  cover: ImageMetadata;
  /** Kunci proyek `<slug>-<nomor cover>` — dipakai popup detail (ProjectModal). */
  project: string;
  title: string;
  desc?: string;
  /** Gambar pertama tiap baris dimuat lebih awal, sisanya lazy. */
  eager?: boolean;
}
const { cover, project, title, desc, eager = false } = Astro.props;
---

<button
  class="card"
  type="button"
  data-project={project}
  aria-haspopup="dialog"
  aria-label={`Lihat detail: ${title}`}
>
  <span class="card-media">
    <Image
      src={cover}
      alt={`Cuplikan video ${title}`}
      widths={[320, 480, 640]}
      sizes="(max-width: 640px) 68vw, (max-width: 1100px) 34vw, 300px"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <span class="card-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
    </span>
  </span>

  <span class="card-body">
    <span class="card-title">{title}</span>
    {desc && <span class="card-desc">{desc}</span>}
  </span>
</button>

<style>
  .card {
    display: block;
    width: clamp(240px, 68vw, 300px);
    text-align: left;
    padding: 0;
    border-radius: var(--radius);
    transition: transform 0.3s var(--ease);
  }

  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-elev);
    box-shadow: var(--shadow);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease), filter 0.3s var(--ease);
  }

  .card-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.25s var(--ease);
  }
  .card-play svg {
    width: 46px;
    height: 46px;
    padding: 12px;
    border-radius: 50%;
    color: var(--text);
    background: rgba(35, 35, 35, 0.65);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line-strong);
    transform: scale(0.85);
    transition: transform 0.25s var(--ease);
  }

  /* Hover cukup halus — setengah detik kemudian kartu pratinjau (ProjectModal) mengambil alih.
     Ikon putar hanya untuk keyboard & layar sentuh, yang tidak mendapat pratinjau. */
  .card:hover .card-media :global(img) { transform: scale(1.04); filter: brightness(1.08); }
  .card:focus-visible .card-media :global(img) { transform: scale(1.04); filter: brightness(0.6); }
  .card:focus-visible .card-play { opacity: 1; }
  .card:focus-visible .card-play svg { transform: scale(1); }
  @media (hover: none) {
    .card:active .card-media :global(img) { transform: scale(0.98); }
  }

  .card-body {
    display: block;
    padding-top: var(--s-3);
  }

  .card-title {
    display: block;
    font-size: var(--t-sm);
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }

  .card-desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: var(--s-1);
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--text-faint);
  }
</style>
