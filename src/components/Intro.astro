---
// Layar pembuka: logo menyala, garis merah berjalan, lalu logo "menembus" ke halaman.
// Hanya sekali per kunjungan (sessionStorage) — pindah halaman tidak memutarnya lagi.
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-tetra-visual.png';
import { site } from '../data/site';
---

<script is:inline>
  try { if (sessionStorage.getItem('tv-intro')) document.documentElement.classList.add('intro-seen'); } catch {}
</script>

<div class="intro" data-intro aria-hidden="true">
  <div class="intro-glow"></div>
  <div class="intro-mark">
    <Image src={logo} alt={site.name} widths={[300, 600]} sizes="240px" loading="eager" fetchpriority="high" />
  </div>
  <span class="intro-bar"><span></span></span>
</div>

<script is:inline>
  (() => {
    const el = document.querySelector('[data-intro]');
    if (!el || document.documentElement.classList.contains('intro-seen')) return;
    const start = performance.now();
    const done = () => {
      // Minimal 1.6 dtk supaya animasi logo selesai, tapi tidak menunggu semua gambar.
      setTimeout(() => {
        el.classList.add('is-done');
        try { sessionStorage.setItem('tv-intro', '1'); } catch {}
        setTimeout(() => el.remove(), 900);
      }, Math.max(0, 1600 - (performance.now() - start)));
    };
    if (document.readyState === 'complete') done();
    else addEventListener('load', done, { once: true });
    setTimeout(done, 3500); // koneksi lambat: jangan tahan pengunjung lebih lama
  })();
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2.25rem;
    background: #141414;
    /* Cadangan tanpa JavaScript: tetap hilang sendiri */
    animation: intro-out 0.8s 5s forwards;
  }
  :global(.intro-seen) .intro { display: none; }

  .intro-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(40% 35% at 50% 50%, rgba(229, 9, 20, 0.22), transparent 70%);
    opacity: 0;
    animation: intro-glow 1.6s 0.3s ease-out forwards;
  }

  .intro-mark :global(img) {
    position: relative;
    width: clamp(150px, 22vw, 240px);
    height: auto;
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.9);
    animation: intro-in 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s forwards;
  }

  .intro-bar {
    position: relative;
    width: clamp(120px, 16vw, 180px);
    height: 2px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.12);
    opacity: 0;
    animation: intro-fade 0.4s 0.6s forwards;
  }
  .intro-bar span {
    position: absolute;
    inset: 0;
    width: 40%;
    background: var(--brand);
    box-shadow: 0 0 12px var(--brand);
    animation: intro-sweep 1.1s cubic-bezier(0.65, 0, 0.35, 1) 0.6s infinite;
  }

  /* Keluar: logo membesar menembus layar sementara latar memudar */
  .intro.is-done { animation: intro-out 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards; pointer-events: none; }
  .intro.is-done .intro-mark :global(img) { animation: intro-through 0.8s cubic-bezier(0.5, 0, 0.75, 0) forwards; opacity: 1; filter: none; }
  .intro.is-done .intro-bar { animation: intro-hide 0.2s forwards; }

  @keyframes intro-in { to { opacity: 1; filter: blur(0); transform: scale(1); } }
  @keyframes intro-fade { to { opacity: 1; } }
  @keyframes intro-hide { to { opacity: 0; } }
  @keyframes intro-glow { 50% { opacity: 1; } to { opacity: 0.6; } }
  @keyframes intro-sweep { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
  @keyframes intro-through { to { transform: scale(1.6); opacity: 0; filter: blur(6px); } }
  @keyframes intro-out { to { opacity: 0; visibility: hidden; } }
</style>
