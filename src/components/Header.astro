---
import { Image } from 'astro:assets';
import logoTetra from '../assets/brand/logo-tetra-visual.png';
import { site, waLink } from '../data/site';

interface Props {
  /** Menyatu dengan hero di halaman yang punya gambar besar di atas. */
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  // Di HP link ini disembunyikan: tombol WhatsApp di sebelahnya sudah jadi kontak.
  { href: '#contact', label: 'Contact', hideOnMobile: true },
];

const isActive = (href: string) => href !== '#contact' && (path === href || path.startsWith(`${href}/`));
---

<header class:list={['hdr', { 'hdr-transparent': transparent }]} data-header>
  <a href="/" class="brand" aria-label={`${site.name} — beranda`}>
    <Image src={logoTetra} alt={site.name} widths={[180, 300]} sizes="84px" loading="eager" />
  </a>

  <nav class="nav" aria-label="Navigasi utama">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={['nav-link', { active: isActive(l.href), 'hide-sm': l.hideOnMobile }]}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))
    }
    <a
      class="btn btn-brand nav-cta"
      href={waLink(`Halo Tetra Visual, saya ingin menanyakan ketersediaan jadwal.`)}
      target="_blank"
      rel="noopener"
    >
      <svg class="nav-cta-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.8 14.13c-.25.69-1.44 1.32-1.99 1.37-.53.05-1.02.24-3.45-.72-2.91-1.15-4.75-4.15-4.89-4.34-.14-.2-1.16-1.55-1.16-2.95s.73-2.09.99-2.38c.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.41-.07.64.49.24.57.8 1.97.87 2.11.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.16-.3.36-.42.49-.14.14-.29.29-.12.57.16.29.73 1.2 1.56 1.94 1.07.96 1.98 1.25 2.26 1.39.28.14.45.12.61-.07.17-.19.71-.83.9-1.11.19-.29.38-.24.64-.14.26.09 1.65.78 1.94.92.28.14.47.21.54.33.07.12.07.69-.18 1.36Z"
        ></path>
      </svg>
      <span class="nav-cta-long">Hubungi Kami</span>
      <span class="nav-cta-short">Chat</span>
    </a>
  </nav>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--gutter);
    background: rgba(10, 12, 14, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  /* Di halaman hero besar: header menyatu dengan gambar, lalu memadat saat di-scroll */
  .hdr-transparent {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent);
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .hdr-transparent:global(.scrolled) {
    background: rgba(10, 12, 14, 0.9);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  /* Wordmark asli Tetra Visual. PNG putih berlatar transparan, jadi tidak
     butuh filter apa pun di atas header gelap. */
  .brand { display: flex; align-items: center; }
  .brand :global(img) {
    width: auto;
    height: 40px;
    transition: opacity 0.25s var(--ease);
  }
  .brand:hover :global(img) { opacity: 0.72; }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }

  .nav-link {
    position: relative;
    padding-block: var(--s-2);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--text-dim);
    transition: color 0.2s var(--ease);
  }
  .nav-link:hover { color: var(--text); }
  .nav-link.active { color: var(--text); }

  /* Garis bawah tumbuh dari tengah — pengganti border statis versi lama */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--brand);
    transform: translateX(-50%);
    transition: width 0.25s var(--ease);
  }
  .nav-link:hover::after,
  .nav-link.active::after { width: 100%; }

  /* Label panjang di layar lebar, ringkas di HP — supaya header tidak meluber */
  .nav-cta-short { display: none; }

  @media (max-width: 700px) {
    .hdr { gap: var(--s-3); padding-inline: var(--s-4); }
    .brand :global(img) { height: 32px; }
    .hide-sm { display: none; }        /* "Contact" — tombol WhatsApp sudah menggantikannya */
    .nav { gap: var(--s-4); }
    .nav-cta { padding-inline: var(--s-4); }
    .nav-cta-long { display: none; }
    .nav-cta-short { display: inline; }
  }

  @media (max-width: 360px) {
    .brand :global(img) { height: 28px; }
    .nav-link { font-size: var(--t-xs); }
  }
</style>

<script>
  // Header memadat setelah di-scroll sedikit.
  const header = document.querySelector('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
