---
import { site, waLink } from '../data/site';

interface Props {
  /** Menyatu dengan hero di halaman yang punya gambar besar di atas. */
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];

const isActive = (href: string) => href !== '#contact' && (path === href || path.startsWith(`${href}/`));
---

<header class:list={['hdr', { 'hdr-transparent': transparent }]} data-header>
  <a href="/" class="brand" aria-label={`${site.name} — beranda`}>
    <span class="brand-mark">{site.shortName}</span>
    <span class="brand-sub">VISUAL</span>
  </a>

  <nav class="nav" aria-label="Navigasi utama">
    {
      links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <a
      class="btn btn-brand nav-cta"
      href={waLink(`Halo Tetra Visual, saya ingin menanyakan ketersediaan jadwal.`)}
      target="_blank"
      rel="noopener"
    >
      Hubungi Kami
    </a>
  </nav>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--gutter);
    background: rgba(10, 12, 14, 0.85);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  /* Di halaman hero besar: header menyatu dengan gambar, lalu memadat saat di-scroll */
  .hdr-transparent {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent);
    backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .hdr-transparent:global(.scrolled) {
    background: rgba(10, 12, 14, 0.9);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1;
  }
  .brand-mark { font-size: 1.15rem; color: var(--text); }
  .brand-sub { font-size: 0.6rem; color: var(--brand); letter-spacing: 0.28em; }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
  }

  .nav-link {
    position: relative;
    padding-block: var(--s-2);
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--text-dim);
    transition: color 0.2s var(--ease);
  }
  .nav-link:hover { color: var(--text); }
  .nav-link.active { color: var(--text); }

  /* Garis bawah tumbuh dari tengah — pengganti border statis versi lama */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--brand);
    transform: translateX(-50%);
    transition: width 0.25s var(--ease);
  }
  .nav-link:hover::after,
  .nav-link.active::after { width: 100%; }

  @media (max-width: 560px) {
    .brand-sub { display: none; }
    .nav { gap: var(--s-4); }
    .nav-cta { padding-inline: var(--s-4); font-size: var(--t-xs); }
  }
  /* Di layar sangat sempit, tombol kontak tetap ada tapi teksnya diringkas */
  @media (max-width: 380px) {
    .nav-link { font-size: var(--t-xs); }
  }
</style>

<script>
  // Header memadat setelah di-scroll sedikit.
  const header = document.querySelector('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
