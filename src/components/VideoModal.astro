---
// Satu pemutar untuk seluruh halaman. Tombol mana pun yang punya
// data-video-id akan membukanya — tidak perlu skrip tambahan per baris.
---

<dialog class="vm" data-video-modal aria-label="Pemutar video">
  <button class="vm-close" type="button" data-video-close aria-label="Tutup video">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"
      ><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg
    >
  </button>

  <div class="vm-frame">
    <iframe
      data-video-frame
      title="Pemutar video YouTube"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>

  <p class="vm-title" data-video-caption></p>
</dialog>

<style>
  .vm {
    width: min(1200px, 92vw);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }
  .vm::backdrop {
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(8px);
  }
  /* Masuk seperti layar bioskop menyala: gelap dulu, lalu pemutar membesar pelan */
  .vm[open] { animation: vm-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .vm[open]::backdrop { animation: vm-fade 0.35s ease-out both; }
  @keyframes vm-in { from { opacity: 0; transform: scale(0.92); } }
  @keyframes vm-fade { from { opacity: 0; } }

  .vm-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow-lg);
  }
  .vm-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .vm-title {
    margin-top: var(--s-4);
    text-align: center;
    font-size: var(--t-sm);
    color: var(--text-dim);
  }

  .vm-close {
    position: absolute;
    top: -3rem;
    right: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--text);
    background: rgba(255, 255, 255, 0.1);
    transition: background-color 0.2s var(--ease);
  }
  .vm-close:hover { background: rgba(255, 255, 255, 0.22); }

  @media (max-width: 600px) {
    .vm { width: 96vw; }
    .vm-close { top: -3.25rem; right: 50%; transform: translateX(50%); }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-video-modal]');
  const frame = modal?.querySelector<HTMLIFrameElement>('[data-video-frame]');
  const caption = modal?.querySelector<HTMLElement>('[data-video-caption]');

  if (modal && frame && caption) {
    const close = () => {
      // Kosongkan src supaya video berhenti dan berhenti memakai kuota.
      frame.src = '';
      if (modal.open) modal.close();
    };

    // Satu listener untuk semua tombol video di halaman, sekarang maupun nanti.
    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element | null)?.closest<HTMLElement>('[data-video-id]');
      if (!trigger) return;

      const id = trigger.dataset.videoId;
      if (!id) return;

      // nocookie: YouTube tidak menanam cookie pelacak sebelum video diputar.
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      caption.textContent = trigger.dataset.videoTitle ?? '';
      modal.showModal();
    });

    modal.querySelector('[data-video-close]')?.addEventListener('click', close);

    // Esc ditangani <dialog> secara bawaan — pastikan video ikut berhenti.
    modal.addEventListener('close', () => { frame.src = ''; });

    // Klik di luar kotak video juga menutup.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
  }
</script>
